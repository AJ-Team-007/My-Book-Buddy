rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // 1. UserProfile Validation Blueprint (No PII stored)
    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'classGrade',
        'board',
        'school',
        'avatarGradient',
        'initials',
        'memberSince',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'displayName',
        'classGrade',
        'board',
        'school',
        'avatarGradient',
        'initials',
        'memberSince',
        'updatedAt'
      ]) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.uid == request.auth.uid &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
      data.classGrade is string && data.classGrade.size() >= 1 && data.classGrade.size() <= 40 &&
      data.board is string && data.board.size() >= 1 && data.board.size() <= 40 &&
      data.school is string && data.school.size() >= 1 && data.school.size() <= 120 &&
      data.avatarGradient is string && data.avatarGradient.size() >= 1 && data.avatarGradient.size() <= 100 &&
      data.initials is string && data.initials.size() >= 1 && data.initials.size() <= 6 &&
      data.memberSince is string && data.memberSince.size() >= 1 && data.memberSince.size() <= 40 &&
      data.updatedAt is timestamp;
    }

    // 2. BookListing Validation Blueprint
    function isValidBookListing(data) {
      return data.keys().hasAll([
        'ownerUid',
        'sellerId',
        'sellerName',
        'sellerDisplay',
        'title',
        'author',
        'subject',
        'classGrade',
        'board',
        'medium',
        'edition',
        'condition',
        'price',
        'originalPrice',
        'description',
        'coverImage',
        'galleryImages',
        'status',
        'requestsCount',
        'isPublic',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerUid',
        'sellerId',
        'sellerName',
        'sellerDisplay',
        'title',
        'author',
        'subject',
        'classGrade',
        'board',
        'medium',
        'edition',
        'condition',
        'price',
        'originalPrice',
        'description',
        'coverImage',
        'galleryImages',
        'status',
        'requestsCount',
        'isPublic',
        'createdAt',
        'updatedAt'
      ]) &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.sellerId is string && data.sellerId.size() >= 1 && data.sellerId.size() <= 128 && data.sellerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.sellerName is string && data.sellerName.size() >= 1 && data.sellerName.size() <= 80 &&
      data.sellerDisplay is string && data.sellerDisplay.size() >= 1 && data.sellerDisplay.size() <= 100 &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
      data.author is string && data.author.size() >= 1 && data.author.size() <= 120 &&
      data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 60 &&
      data.classGrade is string && data.classGrade.size() >= 1 && data.classGrade.size() <= 40 &&
      data.board is string && data.board.size() >= 1 && data.board.size() <= 40 &&
      data.medium is string && (data.medium == 'English' || data.medium == 'Hindi') &&
      data.edition is string && data.edition.size() >= 1 && data.edition.size() <= 80 &&
      data.condition is string && (data.condition == 'Like New' || data.condition == 'Good' || data.condition == 'Used' || data.condition == 'Heavily Used') &&
      data.price is number && data.price >= 1 && data.price <= 50000 &&
      data.originalPrice is number && data.originalPrice >= 1 && data.originalPrice <= 50000 &&
      data.description is string && data.description.size() >= 1 && data.description.size() <= 1000 &&
      data.coverImage is string && data.coverImage.size() >= 1 && data.coverImage.size() <= 200000 &&
      data.galleryImages is list && data.galleryImages.size() >= 1 && data.galleryImages.size() <= 5 &&
      data.galleryImages[0] is string && data.galleryImages[0].size() <= 200000 &&
      data.status is string && (data.status == 'Available' || data.status == 'Sold') &&
      data.requestsCount is number && data.requestsCount >= 0 && data.requestsCount <= 10000 &&
      data.isPublic is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // 3. BuyRequest Validation Blueprint
    function isValidBuyRequest(data) {
      return data.keys().hasAll([
        'bookId',
        'bookTitle',
        'bookCover',
        'bookPrice',
        'bookCondition',
        'buyerUid',
        'buyerId',
        'buyerName',
        'buyerAvatarGradient',
        'buyerInitials',
        'sellerUid',
        'sellerId',
        'sellerName',
        'message',
        'status',
        'isPublic',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'bookId',
        'bookTitle',
        'bookCover',
        'bookPrice',
        'bookCondition',
        'buyerUid',
        'buyerId',
        'buyerName',
        'buyerAvatarGradient',
        'buyerInitials',
        'sellerUid',
        'sellerId',
        'sellerName',
        'message',
        'status',
        'isPublic',
        'createdAt',
        'updatedAt'
      ]) &&
      data.bookId is string && data.bookId.size() >= 1 && data.bookId.size() <= 128 && data.bookId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.bookTitle is string && data.bookTitle.size() >= 1 && data.bookTitle.size() <= 150 &&
      data.bookCover is string && data.bookCover.size() >= 1 && data.bookCover.size() <= 200000 &&
      data.bookPrice is number && data.bookPrice >= 1 && data.bookPrice <= 50000 &&
      data.bookCondition is string && (data.bookCondition == 'Like New' || data.bookCondition == 'Good' || data.bookCondition == 'Used' || data.bookCondition == 'Heavily Used') &&
      data.buyerUid is string && data.buyerUid.size() >= 1 && data.buyerUid.size() <= 128 && data.buyerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.buyerId is string && data.buyerId.size() >= 1 && data.buyerId.size() <= 128 && data.buyerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.buyerName is string && data.buyerName.size() >= 1 && data.buyerName.size() <= 100 &&
      data.buyerAvatarGradient is string && data.buyerAvatarGradient.size() >= 1 && data.buyerAvatarGradient.size() <= 100 &&
      data.buyerInitials is string && data.buyerInitials.size() >= 1 && data.buyerInitials.size() <= 6 &&
      data.sellerUid is string && data.sellerUid.size() >= 1 && data.sellerUid.size() <= 128 && data.sellerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.sellerId is string && data.sellerId.size() >= 1 && data.sellerId.size() <= 128 && data.sellerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.sellerName is string && data.sellerName.size() >= 1 && data.sellerName.size() <= 100 &&
      data.message is string && data.message.size() >= 1 && data.message.size() <= 250 &&
      data.status is string && (data.status == 'Pending' || data.status == 'Accepted' || data.status == 'Declined' || data.status == 'Completed') &&
      data.isPublic is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // 4. Conversation Validation Blueprint
    function isValidConversation(data) {
      return data.keys().hasAll([
        'bookId',
        'bookTitle',
        'bookPrice',
        'bookCondition',
        'bookCover',
        'ownerUid',
        'otherStudentId',
        'otherStudentName',
        'otherStudentClass',
        'otherStudentAvatarGradient',
        'otherStudentInitials',
        'lastMessage',
        'lastTimestamp',
        'unreadCount',
        'isPublic',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'bookId',
        'bookTitle',
        'bookPrice',
        'bookCondition',
        'bookCover',
        'ownerUid',
        'otherStudentId',
        'otherStudentName',
        'otherStudentClass',
        'otherStudentAvatarGradient',
        'otherStudentInitials',
        'lastMessage',
        'lastTimestamp',
        'unreadCount',
        'isPublic',
        'createdAt',
        'updatedAt'
      ]) &&
      data.bookId is string && data.bookId.size() >= 1 && data.bookId.size() <= 128 && data.bookId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.bookTitle is string && data.bookTitle.size() >= 1 && data.bookTitle.size() <= 150 &&
      data.bookPrice is number && data.bookPrice >= 1 && data.bookPrice <= 50000 &&
      data.bookCondition is string && (data.bookCondition == 'Like New' || data.bookCondition == 'Good' || data.bookCondition == 'Used' || data.bookCondition == 'Heavily Used') &&
      data.bookCover is string && data.bookCover.size() >= 1 && data.bookCover.size() <= 200000 &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.otherStudentId is string && data.otherStudentId.size() >= 1 && data.otherStudentId.size() <= 128 && data.otherStudentId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.otherStudentName is string && data.otherStudentName.size() >= 1 && data.otherStudentName.size() <= 100 &&
      data.otherStudentClass is string && data.otherStudentClass.size() >= 1 && data.otherStudentClass.size() <= 60 &&
      data.otherStudentAvatarGradient is string && data.otherStudentAvatarGradient.size() >= 1 && data.otherStudentAvatarGradient.size() <= 100 &&
      data.otherStudentInitials is string && data.otherStudentInitials.size() >= 1 && data.otherStudentInitials.size() <= 6 &&
      data.lastMessage is string && data.lastMessage.size() >= 1 && data.lastMessage.size() <= 500 &&
      data.lastTimestamp is string && data.lastTimestamp.size() >= 1 && data.lastTimestamp.size() <= 40 &&
      data.unreadCount is number && data.unreadCount >= 0 && data.unreadCount <= 1000 &&
      data.isPublic is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // 5. ChatMessage Validation Blueprint
    function isValidChatMessage(data) {
      return data.keys().hasAll([
        'conversationId',
        'senderUid',
        'senderId',
        'text',
        'timestamp',
        'read',
        'isPublic',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'conversationId',
        'senderUid',
        'senderId',
        'text',
        'timestamp',
        'read',
        'attachedPhoto',
        'isPublic',
        'createdAt'
      ]) &&
      data.conversationId is string && data.conversationId.size() >= 1 && data.conversationId.size() <= 128 && data.conversationId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 && data.senderUid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.senderUid == request.auth.uid &&
      data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 && data.senderId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
      data.timestamp is string && data.timestamp.size() >= 1 && data.timestamp.size() <= 40 &&
      data.read is bool &&
      (!('attachedPhoto' in data) || (data.attachedPhoto is string && data.attachedPhoto.size() <= 200000)) &&
      data.isPublic is bool &&
      data.createdAt is timestamp;
    }

    // 6. BookReport Validation Blueprint
    function isValidBookReport(data) {
      return data.keys().hasAll([
        'bookTitle',
        'reporterUid',
        'reason',
        'notes',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'bookTitle',
        'reporterUid',
        'reason',
        'notes',
        'createdAt'
      ]) &&
      data.bookTitle is string && data.bookTitle.size() >= 1 && data.bookTitle.size() <= 150 &&
      data.reporterUid is string && data.reporterUid.size() >= 1 && data.reporterUid.size() <= 128 && data.reporterUid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.reporterUid == request.auth.uid &&
      data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 120 &&
      data.notes is string && data.notes.size() <= 500 &&
      data.createdAt is timestamp;
    }

    // Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && existing().uid == userId;
      allow list: if isSignedIn() && existing().uid == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(userId) && userId == request.auth.uid &&
        isValidUserProfile(incoming()) && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(userId) && userId == request.auth.uid &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().memberSince == existing().memberSince &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'classGrade', 'board', 'school', 'avatarGradient', 'initials', 'updatedAt']);
    }

    // Collection: /books/{bookId}
    match /books/{bookId} {
      allow get: if isValidId(bookId) && (existing().isPublic == true || (isSignedIn() && existing().ownerUid == request.auth.uid));
      allow list: if existing().isPublic == true || (isSignedIn() && existing().ownerUid == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(bookId) &&
        isValidBookListing(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(bookId) &&
        isValidBookListing(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action 1: Owner edits book details or status
          (existing().ownerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'author', 'subject', 'classGrade', 'board', 'medium', 'edition',
              'condition', 'price', 'originalPrice', 'description', 'coverImage',
              'galleryImages', 'status', 'updatedAt'
            ])
          ) ||
          // Action 2: Verified student increments requestsCount or toggles demo book status
          (existing().isPublic == true &&
            incoming().diff(existing()).affectedKeys().hasOnly(['requestsCount', 'status', 'updatedAt'])
          )
        );
    }

    // Collection: /requests/{requestId}
    match /requests/{requestId} {
      allow get: if isValidId(requestId) && (existing().isPublic == true || (isSignedIn() && (existing().buyerUid == request.auth.uid || existing().sellerUid == request.auth.uid)));
      allow list: if existing().isPublic == true || (isSignedIn() && (existing().buyerUid == request.auth.uid || existing().sellerUid == request.auth.uid));
      allow create: if isVerifiedUser() && isValidId(requestId) &&
        isValidBuyRequest(incoming()) &&
        incoming().buyerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/books/$(incoming().bookId));
      allow update: if isVerifiedUser() && isValidId(requestId) &&
        isValidBuyRequest(incoming()) &&
        existing().status != 'Declined' &&
        existing().status != 'Completed' &&
        incoming().bookId == existing().bookId &&
        incoming().buyerUid == existing().buyerUid &&
        incoming().sellerUid == existing().sellerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (existing().sellerUid == request.auth.uid || existing().buyerUid == request.auth.uid || existing().isPublic == true) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    // Collection: /conversations/{conversationId}
    match /conversations/{conversationId} {
      allow get: if isValidId(conversationId) && (existing().isPublic == true || (isSignedIn() && existing().ownerUid == request.auth.uid));
      allow list: if existing().isPublic == true || (isSignedIn() && existing().ownerUid == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(conversationId) &&
        isValidConversation(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/books/$(incoming().bookId));
      allow update: if isVerifiedUser() && isValidId(conversationId) &&
        isValidConversation(incoming()) &&
        incoming().bookId == existing().bookId &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (existing().ownerUid == request.auth.uid || existing().isPublic == true) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastTimestamp', 'unreadCount', 'updatedAt']);

      // Subcollection: /conversations/{conversationId}/messages/{messageId}
      match /messages/{messageId} {
        allow get: if isValidId(conversationId) && isValidId(messageId) &&
          (existing().isPublic == true || (isSignedIn() && existing().senderUid == request.auth.uid)) &&
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.isPublic == true;
        allow list: if existing().isPublic == true || (isSignedIn() && existing().senderUid == request.auth.uid);
        allow create: if isVerifiedUser() && isValidId(conversationId) && isValidId(messageId) &&
          isValidChatMessage(incoming()) &&
          incoming().conversationId == conversationId &&
          incoming().createdAt == request.time &&
          (
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.ownerUid == request.auth.uid ||
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.isPublic == true
          );
      }
    }

    // Collection: /reports/{reportId}
    match /reports/{reportId} {
      allow get: if isVerifiedUser() && isValidId(reportId) && existing().reporterUid == request.auth.uid;
      allow list: if isVerifiedUser() && existing().reporterUid == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(reportId) &&
        isValidBookReport(incoming()) &&
        incoming().createdAt == request.time;
    }
  }
}
